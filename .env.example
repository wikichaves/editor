# OpenAI API key — required for EN→ES translation.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Vercel Blob — required for large-file uploads and storing the result.
# Auto-set when you connect a Blob store to the project in Vercel.
# Locally: run `vercel env pull` or paste the token here.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Resend — required only if you want to email the resulting ePub.
# Get a key at https://resend.com/ (free tier).
RESEND_API_KEY=re_...
# Optional "from" address (display name + email). Without a verified domain,
# Resend's onboarding sender only delivers to the Resend account owner's email.
# Verify a domain in Resend to send from your own address to anyone.
# EMAIL_FROM=Wiki Editor <editor@tudominio.com>

# Optional: every generated ePub is also copied (bcc) to this address, as a
# personal archive and as confirmation. Failure notices are sent here too —
# important when the recipient is a @kindle.com address, since Amazon discards
# anything that isn't a document.
# EMAIL_ARCHIVE=vos@gmail.com

# Optional: shown in the app's Kindle instructions as the address to approve
# in Amazon's "Approved Personal Document E-mail List". Should match EMAIL_FROM.
# NEXT_PUBLIC_SENDER_EMAIL=editor@tudominio.com
